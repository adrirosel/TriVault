# Entorno de ejecucion: development | test | production
ENVIRONMENT=development

# Base de datos principal (MySQL local -> Supabase PostgreSQL en Fase 4)
DATABASE_URL=mysql+pymysql://local_db_user:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:3307/trivault_local_db

# Base de datos aislada para Pytest (no ensucia desarrollo)
TEST_DATABASE_URL=mysql+pymysql://local_test_user:REPLACE_WITH_TEST_DB_PASSWORD@127.0.0.1:3307/trivault_test_db

# Configuracion del pool de SQLAlchemy (usar true en Vercel Serverless)
DB_USE_NULL_POOL=false
DB_POOL_RECYCLE=300

# JWT (generar una clave aleatoria segura de >= 32 bytes en cada entorno)
SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes CORS permitidos (JSON array o separados por comas; nunca '*' en produccion)
ALLOWED_ORIGINS=["http://localhost:5173"]
